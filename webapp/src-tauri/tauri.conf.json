{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ryn",
  "version": "0.6.2",
  "identifier": "ai.rynmesh.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ryn",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/rynmesh-peer"],
    "resources": {
      "resources/llama/": "llama/"
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "sidecar/rynmesh-peer.entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
