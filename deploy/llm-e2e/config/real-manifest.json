{
  "package_id": "e2e-real-service",
  "mode": "openai_compatible",
  "public_model_alias": "private-local-gguf",
  "adapter": "openai_compatible",
  "runtime": "docker_llama_cpp",
  "base_url": "http://real-llm:8080",
  "allow_non_loopback": true,
  "model": "",
  "capabilities": ["text-generation"],
  "context_window": 2048,
  "max_output_tokens": 128,
  "max_concurrent": 1,
  "queue_limit": 0,
  "timeout_seconds": 120,
  "pricing": {"currency": "DEV_TASK_BALANCE", "input_per_1k": 0.001, "output_per_1k": 0.002, "minimum": 0.001, "maximum_per_task": 1.0},
  "privacy": {"log_bodies": false, "temporary_storage": false, "retention_seconds": 0, "compute_node_sees_plaintext": true, "policy_text": "No body logging; Provider necessarily sees plaintext during inference."},
  "risk_labels": ["operator-supplied-model", "license-review-required"],
  "content_rules": "Provider policy applies.",
  "license_id": "operator-supplied"
}
