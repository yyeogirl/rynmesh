{
  "package_id": "e2e-p2p-host-real-service",
  "mode": "openai_compatible",
  "public_model_alias": "p2p-direct-host-private-model",
  "adapter": "openai_compatible",
  "runtime": "external",
  "base_url": "http://127.0.0.1:8080",
  "allow_non_loopback": false,
  "model": "qwen35-4b-vlm",
  "capabilities": ["text-generation"],
  "context_window": 4096,
  "max_output_tokens": 128,
  "max_concurrent": 1,
  "queue_limit": 0,
  "timeout_seconds": 180,
  "pricing": {"currency": "DEV_TASK_BALANCE", "input_per_1k": 0.001, "output_per_1k": 0.002, "minimum": 0.001, "maximum_per_task": 1.0},
  "privacy": {"log_bodies": false, "temporary_storage": false, "retention_seconds": 0, "compute_node_sees_plaintext": true, "policy_text": "No body logging; Provider and the owner-managed runtime necessarily see plaintext during inference."},
  "risk_labels": ["owner-managed-runtime", "license-review-required"],
  "content_rules": "Provider policy applies.",
  "license_id": "operator-supplied"
}
